#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// [[Дубровский Р.О. ДЗ13-7_з.2: Доработка процедуры рассчета строки с учетом скидок 08.10.26
	
	КоэффициентСкидки = 1 - (ТекущиеДанные.Скидка + Объект.ДК_СогласованнаяСкидка)/ 100;
	
	Если КоэффициентСкидки < 0 Тогда 
		
		КоэффициентСкидки = 0;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("В строке ""%1"" указана не корректная скидка (Суммарный размер скидки не может быть более 100)", ТекущиеДанные.Номенклатура);
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	РассчитатьСуммуДокумента();
	
	// Дубровский Р.О.]]
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДК_СогласованнаяСкидкаПриИзмененииПосле(Элемент)
	
	// [[Дубровский Р.О. ДЗ13-7_з.2: Добавление собития при изменении реквизита "ДК_СогласованнаяСкидка"  08.10.26
	
	Если ЗначениеЗаполнено(Объект.Товары) ИЛИ ЗначениеЗаполнено(Объект.Услуги) Тогда
		
		Ответ = Ждать ВопросАсинх("Скидка изменена, пересчитать таблицу?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			
			ПересчитатьТЧ(Объект.Товары, Объект.Услуги)
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Дубровский Р.О.]]
	
КонецПроцедуры 

&НаКлиенте
Процедура ПересчитатьТЧ(ТаблицаТовары, ТаблицаУслуги)
	
	// [[Дубровский Р.О. ДЗ13-7_з.2: Доработка процедуры с учетом скидок 08.10.26	
	
	Для Каждого СтрокаТЧ Из ТаблицаТовары Цикл
			
			РассчитатьСуммуСтроки(СтрокаТЧ);
		
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из ТаблицаУслуги Цикл
					
			РассчитатьСуммуСтроки(СтрокаТЧ);
			
	КонецЦикла;
	
	// Дубровский Р.О.]]
	
КонецПроцедуры


